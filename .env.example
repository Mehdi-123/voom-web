# The same Supabase project as the Voom app (public values: safe to expose, row level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The address the site is published at, used for links in Google results
NEXT_PUBLIC_SITE_URL=https://voomrental.com
# Cloudflare Turnstile (free): the bot check on agency sign-up and password reset. Leave both empty to switch it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
